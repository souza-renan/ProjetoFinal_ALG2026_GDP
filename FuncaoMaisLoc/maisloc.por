programa
{
//Filme mais locado 
//A opção Filme mais locado deve imprimir todas as informações sobre o filme 
//mais locado durante a execução do programa	
	funcao maisloc(inteiro filme){ // responsavel por comparar a quantidade de vezes que o filme foi alugado
		inteiro i, j, filmeloc 
		para(i=0; i<=10; i++)
		para(j=0; j<=10; j++)
			filme = i + j
	}
	funcao inicio()
	{
		inteiro fil, filmesloc = 10 
		fil = filmesloc
		filmesloc(maisloc())
		escreva ("==== FILME MAIS LOCADO: " , fil)
	}
}
